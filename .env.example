# Copy to .env and fill in real values. Never commit the real .env.
# On Render, set these as service environment variables instead of a file.

# ── Runtime ─────────────────────────────────────────────────────────────
APP_ENV=development          # "development" enables text logs + debug level; use "production" on Render
PORT=8080

# ── Database (required) ─────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── JWT secrets (required) ──────────────────────────────────────────────
# Generate each with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-64

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ── Google Sign-In (required) ──────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (used to verify ID tokens).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── Refresh-token cookie ───────────────────────────────────────────────
# COOKIE_SAME_SITE=none is required when the frontend and backend are on
# different registrable domains (e.g. Vercel + Render); it also forces
# COOKIE_SECURE=true. Use "lax" only for same-site localhost dev.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── CORS: allowed browser origins ──────────────────────────────────────
# Comma-separated, exact origins (scheme + host + optional port), NO trailing
# slash, NO spaces. Any browser Origin not listed here is refused CORS and
# blocked from the cookie-authenticated routes.
#
# If unset, the server falls back to:
#     http://localhost:3000,http://localhost:3001
# (3000 = web client, 3001 = admin console — local dev only).
#
# PRODUCTION (Render): you MUST set this explicitly to the deployed Vercel
# domains, or the live client will get CORS errors. Include every origin
# that hits the API — the primary client, the admin app, and any stable
# preview domains. Example:
#     ALLOWED_ORIGINS=https://olympiadnext.vercel.app,https://admin.olympiadnext.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email: SMTP (required in production) ───────────────────────────────
# Used to deliver the 6-digit email-verification OTP. When
# SMTP_USERNAME/SMTP_PASSWORD are unset, OTPs are logged to the console
# instead of sent, so local dev works without a live mailbox. Port 465
# (implicit TLS) is the default because Render blocks outbound port 587
# (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
